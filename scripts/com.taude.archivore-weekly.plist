<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs scripts/weekly_pipeline.sh every Monday morning. Install by copying
  this file to ~/Library/LaunchAgents/ (adjusting the Hour below first if
  7am doesn't suit) and running `launchctl load`. Full instructions in
  docs/weekly-pipeline.md.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.taude.archivore-weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/taude/dev/python-test/scripts/weekly_pipeline.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Launchd jobs get a minimal PATH and no login-shell environment, so
         the script resolves its own binaries by absolute path — this just
         needs to exist and be writable. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/taude/Library/Logs/archivore/weekly-pipeline/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/taude/Library/Logs/archivore/weekly-pipeline/launchd.err.log</string>

    <!-- Don't relaunch immediately if a run crashes outright — wait for
         next Monday rather than loop. -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
